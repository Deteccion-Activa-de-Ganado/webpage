# Airtable – Encuesta DAG
# Copiá este archivo como .env.local y completá los valores reales.
# .env.local está en .gitignore y nunca se sube al repositorio.

# 1. Personal Access Token — https://airtable.com/create/tokens
#    Scopes: data.records:read y data.records:write
#    En "Access": agregá SOLO la base que uses (no "All bases" si no hace falta)
VITE_AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 2. ID de la base (empieza con "app") — URL: airtable.com/appXXXXXXXX/...
VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# 3. Encuesta (/encuesta): nombre de tabla (ej. Encuestas) O id (ej. tblXXXXXXXX)
VITE_AIRTABLE_TABLE_NAME=Encuestas

# --- Formulario "Pedí una demo" (inicio, #demo) — solo correo, NO usa Airtable ---
# 1. Entrá a https://web3forms.com y creá una Access Key
# 2. En el panel de Web3Forms, configurá el correo destino: dag.fiuba@gmail.com
# 3. Pegá la clave acá y reiniciá `npm run dev`
VITE_WEB3FORMS_ACCESS_KEY=
