# Airtable – Encuesta DAG
# Copiá este archivo como .env.local y completá los valores reales.
# .env.local está en .gitignore y nunca se sube al repositorio.

# 1. Tu Personal Access Token de Airtable
#    Crealo en: https://airtable.com/create/tokens
#    Scopes necesarios: data.records:write
VITE_AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 2. ID de tu base de Airtable (empieza con "app")
#    Lo encontrás en la URL de tu base: airtable.com/appXXXXXXXXXXXXXX/...
VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# 3. Nombre de la tabla donde se guardarán las respuestas (por defecto: "Encuestas")
VITE_AIRTABLE_TABLE_NAME=Encuestas
